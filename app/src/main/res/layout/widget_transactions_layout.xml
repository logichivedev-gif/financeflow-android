<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FinanceFlow • Gastos Recientes"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Summary section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible: "
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_tx_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 €"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="8dp" />

    <!-- Transactions List Container -->
    <LinearLayout
        android:id="@+id/widget_tx_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/widget_tx_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_tx_category_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comida"
                android:textColor="#F1F5F9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_tx_amount_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-12.50 €"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/widget_tx_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_tx_category_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transporte"
                android:textColor="#F1F5F9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_tx_amount_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-5.00 €"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/widget_tx_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_tx_category_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ocio"
                android:textColor="#F1F5F9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_tx_amount_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-15.00 €"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty text indicator -->
        <TextView
            android:id="@+id/widget_tx_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin gastos registrados"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
